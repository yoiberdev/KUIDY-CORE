# ---------------------------------------------------------------------------
# Local development (pnpm dev). See docs/DESPLIEGUE-CLOUD-RUN.md for Cloud Run.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://kuidy:kuidy_dev@localhost:5435/kuidy_core
JWT_SECRET=change-me-in-prod-please-this-must-be-long-and-random
NODE_ENV=development

# Local ports. In a container Cloud Run injects PORT and it wins over API_PORT.
API_PORT=3000
WEB_PORT=5173

# --- optional -------------------------------------------------------------
# TLS for Postgres: auto honours ?sslmode= in DATABASE_URL (Neon sets it).
# auto | require | no-verify | disable
# DATABASE_SSL=auto
# DB_POOL_MAX=5

# Migrate (and optionally seed) on startup. The Docker image sets
# RUN_MIGRATIONS=true; locally you normally run `pnpm --filter @kuidy/api db:migrate`.
# RUN_MIGRATIONS=false
# SEED_DEMO=false
# DEMO_PASSWORD=Demo1234!

# Extra CORS origins (comma separated). A same-origin deploy needs none.
# CORS_ORIGINS=http://localhost:5173

# Directory holding the built frontend. Defaults to ../public next to dist/.
# WEB_ROOT=
