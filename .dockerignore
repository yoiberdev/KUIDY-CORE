# Never ship or even send to the build daemon:
node_modules
**/node_modules
dist
**/dist
build
**/build
.git
.gitignore
.github

# A tsc incremental cache leaking into the context makes the build believe the
# output is already up to date and emit NOTHING — dist ends up empty.
*.tsbuildinfo
**/*.tsbuildinfo
.turbo
**/.turbo

# pnpm store / local caches
.pnpm-store
**/.pnpm-store

# Secrets and local config
.env
.env.*
!.env.example

# Not needed to build or run the image
docs
coverage
*.log
.vscode
.idea
.DS_Store
.editorconfig
docker-compose.yml
Dockerfile
.dockerignore
CLAUDE.md
